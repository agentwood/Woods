# JoinWoods Supabase Postgres (pooler). Leave unset for local PGLite.
# Format: postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
# Project: ktavvdnaxtgaursekbzu
# Apply schema: npm run db:migrate
DATABASE_URL=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080

# Native Google (callback: http://localhost:8080/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_AUTH=true

# Optional Grok broker (preview only)
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
# VITE_GROK_AUTH=true

# Password reset. Without RESEND_API_KEY, the link prints in the terminal.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Woods <noreply@joinwoods.co>

# Stripe — Woods Club $29.99 / mo or $239.88 / year
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=price_1U6dsRJelDe3AJZ5cq2A2nju
STRIPE_PRICE_YEARLY=price_1U6dsRJelDe3AJZ5qVr0d6L1
